#!/usr/bin/env bash
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
if command -v python3 >/dev/null 2>&1; then
  python3 "$root/.githooks/check-message.py" "$1"
elif command -v python >/dev/null 2>&1; then
  python "$root/.githooks/check-message.py" "$1"
else
  echo "JS 提交检查需要 Python 3，请安装或在推送前使用已有环境执行检查。" >&2
  exit 1
fi
